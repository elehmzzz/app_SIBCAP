<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- pa que conecte con internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App_SIBCAP">
        <activity
            android:name=".vista.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- vista que se debe abrir es el BienvenidaActivity -->
        <activity
            android:name=".vista.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".vista.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Alexa: Mi perfil -->
        <activity
            android:name=".vista.PerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Jhonatan: Bienvenida, Catálogo y Detalle del libro -->
        <activity
            android:name=".vista.BienvenidaActivity"
            android:exported="false" />
        <activity
            android:name=".vista.CatalogoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".vista.DetalleLibroActivity"
            android:exported="false" />
        <activity
            android:name=".vista.OpcionesCuentaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".vista.EditarPerfilActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Hermelinda: Mis préstamos y detalle -->
        <activity
            android:name=".vista.PrestamosActivity"
            android:exported="false" />
        <activity
            android:name=".vista.DetallePrestamoActivity"
            android:exported="false" />


    </application>



</manifest>