<?xml version="1.0" encoding="utf-8"?>
<!--
    ENCABEZADO SIBCAP (compartido por todo el equipo)
    Úsalo arriba de tu pantalla con:
        <include android:id="@+id/encabezado" layout="@layout/layout_encabezado" ... />
    y en tu Activity, en lugar del bloque de ViewCompat, llama:
        Plantilla.aplicarMargenes(this)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/verde_oscuro"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="28dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="48dp"
            android:contentDescription="@string/plantilla_logo_sibcap"
            android:src="@drawable/logo_sibcap" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/plantilla_sibcap"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
