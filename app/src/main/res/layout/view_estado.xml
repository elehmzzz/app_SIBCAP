<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/estadoTarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_estado_tarjeta"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <FrameLayout
            android:id="@+id/estadoCirculo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_circulo_estado">

            <ProgressBar
                android:id="@+id/estadoProgreso"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="Cargando"
                android:indeterminateTint="@color/sib_primario" />

            <TextView
                android:id="@+id/estadoSimbolo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:textColor="@color/sib_primario"
                android:textSize="43sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/estadoTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/sib_texto_valor"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/estadoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/sib_texto_estado"
            android:textSize="15sp" />

        <Button
            android:id="@+id/estadoBoton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_boton_estado"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/sib_blanco"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</merge>
