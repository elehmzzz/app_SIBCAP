<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialogo_lector"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="26dp"
    android:paddingBottom="40dp">

    <TextView
        android:id="@+id/txtTituloEdicionExitosa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Información actualizada"
        android:textColor="@color/lector_texto_principal"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMensajeEdicionExitosa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:text="Tus datos personales se guardaron correctamente."
        android:textColor="@color/lector_texto_principal"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnVolverPerfil"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginTop="64dp"
        android:background="@drawable/lector_boton_primario"
        app:backgroundTint="@color/lector_boton_primario"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:elevation="0dp"
        android:text="Volver a Mi perfil"
        android:textAllCaps="false"
        android:textColor="@color/lector_texto_boton_primario"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>