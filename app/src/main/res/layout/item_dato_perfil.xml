<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginBottom="9dp"
    android:background="@drawable/lector_tarjeta_dato"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="15dp">

    <TextView
        android:id="@+id/txtEtiquetaDato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/lector_texto_secundario"
        android:textSize="12sp"
        tools:text="Etiqueta del dato" />

    <TextView
        android:id="@+id/txtValorDato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:textColor="@color/lector_texto_principal"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Valor del dato" />

</LinearLayout>
