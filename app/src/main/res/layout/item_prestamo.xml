<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_tarjeta_prestamo"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="16dp"
    android:paddingEnd="12dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Portada: mientras no haya imagen (portada_url es null) se muestra la inicial del título -->
        <TextView
            android:id="@+id/tvItemPortada"
            android:layout_width="59dp"
            android:layout_height="96dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_portada"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/sib_blanco"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="19dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/sib_texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/sib_texto"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Fecha límite de devolución"
                android:textColor="@color/sib_texto_secundario"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvItemFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/sib_texto"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemEstado"
            android:layout_width="142dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textColor="@color/sib_texto_valor"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multa acumulada"
                android:textColor="@color/sib_texto_etiqueta"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemMulta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnVerDetalles"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_boton_estado"
        android:stateListAnimator="@null"
        android:text="Ver detalles"
        android:textAllCaps="false"
        android:textColor="@color/sib_tarjeta"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
