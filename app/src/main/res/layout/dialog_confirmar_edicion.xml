<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialogo_lector"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="26dp"
    android:paddingBottom="30dp">

    <TextView
        android:id="@+id/txtTituloConfirmacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Guardar cambios?"
        android:textColor="@color/lector_texto_principal"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMensajeConfirmacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="58dp"
        android:text="¿Confirmas actualizar tu usuario, correo electrónico y teléfono?"
        android:textColor="@color/lector_texto_principal"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelarEdicion"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_boton_cancelar_lector"
            app:backgroundTint="@null"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/texto_negro"
            android:textSize="14sp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:backgroundTint="@null"
            />

        <Button
            android:id="@+id/btnConfirmarEdicion"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_weight="1"
            android:background="@drawable/lector_boton_primario"
            app:backgroundTint="@color/lector_boton_primario"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="@color/lector_texto_boton_primario"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:backgroundTint="@null"
            />

    </LinearLayout>

</LinearLayout>